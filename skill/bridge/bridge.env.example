# Agent Watch bridge configuration.
# Copy to "bridge.env" (same dir) or ~/.config/claude-watch/bridge.env and edit.
# Loaded automatically at startup; shell/systemd env vars take precedence.

# --- Telegram pairing-code notifications (optional) ------------------------
# Create a bot via @BotFather -> get the token.
# Get your numeric user id via @userinfobot -> that's the chat id.
# Send your bot any message once so it can DM you.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Network --------------------------------------------------------------
# Port to bind (default scans 7860-7869).
# PORT=7860

# Public endpoint shown in the Telegram message (e.g. your HTTPS tunnel),
# so you know what to type on the watch. Optional.
# CLAUDE_WATCH_PUBLIC_URL=https://watch.example.com
